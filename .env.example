CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kafka: nombres de contenedor en local; en AWS, <ip-privada-kafka>:9092,<ip-privada-kafka>:9093,<ip-privada-kafka>:9094
KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092

# DynamoDB (metricas en vivo). Las claves y el token se renuevan en cada sesion del Learner Lab.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DYNAMODB_TABLA_PAGOS=MetricasPagos

